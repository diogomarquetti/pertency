{
  "$meta": {
    "name": "Pertency Design Tokens",
    "version": "0.1.0",
    "source": "pertency-brandbook-v1.html",
    "note": "Fonte única de verdade. Qualquer mudança aqui deve ser refletida em tokens.css e no tailwind.config. Campos '$status' indicam done (confirmado no brandbook) ou draft (proposta nova desta camada, precisa validação)."
  },

  "color": {
    "$status": "done",
    "blue": {
      "100": "#99CEFF",
      "500": "#2E9AFF",
      "700": "#005FB8",
      "900": "#001A62"
    },
    "navy": {
      "bg": "#000E38"
    },
    "neutral": {
      "bg": "#FAFBFC",
      "surface": "#FFFFFF",
      "ink": "#0F1B2D",
      "muted": "#64748B",
      "line": "#E4E9EF"
    },
    "semantic": {
      "brand": "#2E9AFF",
      "brand-tint": "#EAF4FF",
      "brand-ink": "#103A63"
    }
  },

  "radius": {
    "$status": "done",
    "sm": "9px",
    "md": "14px",
    "lg": "22px",
    "full": "9999px",
    "note": "lg deriva da proporção real do símbolo (~37% da altura do elo)."
  },

  "clearspace": {
    "$status": "done",
    "symbol": "0.25em-relative",
    "note": "25% da altura do símbolo em todos os lados — ver brandbook seção 03."
  },

  "minSize": {
    "$status": "done",
    "digital": "24px",
    "print": "10mm",
    "favicon": "16px (símbolo original + stroke-width 4 de reforço)"
  },

  "typography": {
    "$status": "done",
    "font": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "logotype": "'Dongle', sans-serif"
    },
    "note-logotype": "Dongle é de uso EXCLUSIVO no wordmark da marca. Nunca usar em UI de produto.",
    "scale": {
      "$status": "done",
      "title": { "size": "34px", "weight": 700, "lineHeight": 1.15 },
      "subtitle": { "size": "24px", "weight": 700, "lineHeight": 1.2 },
      "highlight": { "size": "16px", "weight": 700, "lineHeight": 1.3 },
      "body": { "size": "15px", "weight": 400, "lineHeight": 1.6 },
      "caption": { "size": "12.5px", "weight": 500, "lineHeight": 1.4 }
    }
  },

  "spacing": {
    "$status": "done",
    "note": "Grade base de 8px — cada chave representa chave × 8px.",
    "0": "0px",
    "1": "8px",
    "2": "16px",
    "3": "24px",
    "4": "32px",
    "5": "40px",
    "6": "48px",
    "8": "64px",
    "10": "80px",
    "12": "96px",
    "16": "128px",
    "20": "160px",
    "24": "192px"
  },

  "shadow": {
    "$status": "done",
    "sm": "0 1px 2px rgba(15, 27, 45, 0.06)",
    "md": "0 8px 24px -8px rgba(15, 27, 45, 0.16)",
    "lg": "0 24px 48px -16px rgba(15, 27, 45, 0.24)"
  },

  "icon": {
    "$status": "done",
    "library": "lucide",
    "package": "lucide-react",
    "defaultSize": "20px",
    "strokeWidth": 2
  },

  "motion": {
    "$status": "draft",
    "note": "Proposta inicial — ainda não validada.",
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(.4,0,.2,1)",
      "enter": "cubic-bezier(.16,.84,.44,1)"
    }
  }
}
